# ============ Server ============
NODE_ENV=development              # development | production
PORT=3000
API_PREFIX=api/v1
HOST=0.0.0.0
LOG_LEVEL=info                    # debug | info | warn | error

# ============ Database (PostgreSQL + PostGIS) ============
# Managed providers (Neon, Render, AWS): paste the connection string and
# leave DB_* unset. Local/docker-compose uses DB_* below.
DATABASE_URL=                          # e.g. postgresql://user:pass@host:5432/db
DB_HOST=localhost
DB_PORT=5433                      # docker-compose maps Postgres to 5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ride_booking

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6380                   # docker-compose maps Redis to 6380
REDIS_PASSWORD=
REDIS_TLS=false                   # true for managed TLS-only Redis (Upstash, Redis Cloud)

# ============ Kafka ============
KAFKA_BROKERS=localhost:9092      # comma-separated: host1:9092,host2:9092
KAFKA_CLIENT_ID=ride-booking
KAFKA_GROUP_ID=ride-booking-backend

# ============ JWT ============
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=900                # seconds (15 min)
JWT_REFRESH_TTL=2592000           # seconds (30 days)

# ============ OTP ============
OTP_PROVIDER=dev                  # dev | msg91 | twilio
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_DEV_CODE=123456               # accepted only when OTP_PROVIDER=dev
MSG91_AUTH_KEY=                   # required for OTP_PROVIDER=msg91
MSG91_SENDER_ID=OBBIAN
TWILIO_ACCOUNT_SID=               # required for OTP_PROVIDER=twilio
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============ Maps ============
MAPS_PROVIDER=osrm                # google | osrm
GOOGLE_MAPS_API_KEY=              # required for MAPS_PROVIDER=google
OSRM_BASE_URL=http://router.project-osrm.org

# ============ Razorpay (payments) ============
RAZORPAY_KEY_ID=                  # from Razorpay Dashboard -> Keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=          # for the payments webhook endpoint
RAZORPAY_PAYOUT_ACCOUNT=          # RazorpayX account number for driver settlements

# ============ BullMQ ============
BULLMQ_PREFIX=ride-booking

# ============ Rate limiting (global) ============
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ============ Matching / Dispatch ============
MATCHING_RADIUS_KM=8              # search radius around pickup
MATCHING_MAX_CANDIDATES=3         # how many drivers get an offer
MATCHING_OFFER_TTL_SECONDS=30     # driver's window to accept
MATCHING_HEDGED=true              # true = concurrent offers, false = sequential
MATCHING_SEQUENTIAL_WINDOW_MS=8000

# ============ Surge pricing ============
SURGE_ENABLED=false               # turn on dynamic surge
SURGE_MAX_MULTIPLIER=2.5
SURGE_WINDOW_MINUTES=10           # demand counting window
SURGE_DEMAND_THRESHOLD=1.5        # rides-per-online-driver before surge kicks in
SURGE_MULTIPLIER_STEP=0.25
SURGE_CACHE_TTL_SECONDS=60

# ============ Scheduled rides ============
SCHEDULED_RIDES_ENABLED=true
SCHEDULED_RIDES_MAX_HOURS=24      # how far ahead a ride can be booked

# ============ Fraud detection ============
FRAUD_ENABLED=true
FRAUD_MAX_RIDES_PER_HOUR=5
FRAUD_MAX_CONCURRENT_ACTIVE=2     # max REQUESTED/MATCHING/ACCEPTED rides at once
FRAUD_DUPLICATE_WINDOW_MINUTES=10
FRAUD_MAX_DUPLICATES=3            # same-pickup requests in window before block

# ============ Driver settlement (RazorpayX) ============
SETTLEMENT_ENABLED=true
SETTLEMENT_CRON=0 3 * * *         # daily 03:00 (server TZ)
SETTLEMENT_COMMISSION_PERCENT=20

# ============ Analytics ============
ANALYTICS_ENABLED=true
ANALYTICS_DEFAULT_DAYS=30
ANALYTICS_RETENTION_DAYS=90

# ============ FCM push notifications (optional) ============
FCM_SERVICE_ACCOUNT_JSON=         # path to firebase service-account.json

# ============ Email (SendGrid, optional) ============
SENDGRID_API_KEY=                 # required for EMAIL channel
NOTIFICATIONS_FROM_EMAIL=         # verified sender, e.g. no-reply@obbian.com

# ============ Sentry (optional) ============
SENTRY_DSN=

# ============ Server ============
NODE_ENV=development              # development | production
PORT=3000
API_PREFIX=api/v1
HOST=0.0.0.0
LOG_LEVEL=info                    # debug | info | warn | error

# ============ Database (PostgreSQL + PostGIS) ============
# Managed providers (Neon, Render, AWS): paste the connection string and
# leave DB_* unset. Local/docker-compose uses DB_* below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ride_booking
DB_HOST=localhost
DB_PORT=5433                      # docker-compose maps Postgres to 5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ride_booking

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6380                   # docker-compose maps Redis to 6380
REDIS_PASSWORD=
REDIS_TLS=false                   # true for managed TLS-only Redis (Upstash, Redis Cloud)

# ============ Kafka ============
KAFKA_BROKERS=localhost:9092      # comma-separated: host1:9092,host2:9092
KAFKA_CLIENT_ID=ride-booking
KAFKA_GROUP_ID=ride-booking-backend

# ============ Events (transactional outbox) ============
EVENTS_BROKER_ENABLED=false       # true = relay publishes outbox to Kafka
EVENTS_MAX_ATTEMPTS=8             # dead-letter after N failed dispatches
EVENTS_DLQ_RETRY_LIMIT=50         # max rows one admin DLQ-retry call re-queues

# ============ Security ============
CORS_ORIGINS=                     # comma-separated browser origins; empty denies browsers
                                  # e.g. https://app.example.com,https://www.example.com

# ============ JWT ============
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=900                # seconds (15 min)
JWT_REFRESH_TTL=2592000           # seconds (30 days)

# ============ OTP ============
OTP_PROVIDER=dev                  # dev | msg91 | twilio
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_DEV_CODE=123456               # accepted only when OTP_PROVIDER=dev
MSG91_AUTH_KEY=                   # required for OTP_PROVIDER=msg91
MSG91_SENDER_ID=OBBIAN
TWILIO_ACCOUNT_SID=               # required for OTP_PROVIDER=twilio
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============ Maps ============
MAPS_PROVIDER=osrm                # google | osrm
GOOGLE_MAPS_API_KEY=              # required for MAPS_PROVIDER=google
OSRM_BASE_URL=http://router.project-osrm.org

# ============ Razorpay (payments) ============
RAZORPAY_KEY_ID=                  # from Razorpay Dashboard -> Keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=          # for the payments webhook endpoint
RAZORPAY_PAYOUT_ACCOUNT=          # RazorpayX account number for driver settlements

# ============ BullMQ ============
BULLMQ_PREFIX=ride-booking

# ============ Rate limiting (global) ============
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ============ Matching / Dispatch ============
MATCHING_RADIUS_KM=8              # search radius around pickup
MATCHING_MAX_CANDIDATES=3         # how many drivers get an offer
MATCHING_OFFER_TTL_SECONDS=30     # driver's window to accept
MATCHING_HEDGED=true              # true = concurrent offers, false = sequential
MATCHING_SEQUENTIAL_WINDOW_MS=8000

# ============ Surge pricing ============
SURGE_ENABLED=false               # turn on dynamic surge
SURGE_MAX_MULTIPLIER=2.5
SURGE_WINDOW_MINUTES=10           # demand counting window
SURGE_DEMAND_THRESHOLD=1.5        # rides-per-online-driver before surge kicks in
SURGE_MULTIPLIER_STEP=0.25
SURGE_CACHE_TTL_SECONDS=60

# ============ Scheduled rides ============
SCHEDULED_RIDES_ENABLED=true
SCHEDULED_RIDES_MAX_HOURS=24      # how far ahead a ride can be booked

# ============ Fraud detection ============
FRAUD_ENABLED=true
FRAUD_MAX_RIDES_PER_HOUR=5
FRAUD_MAX_CONCURRENT_ACTIVE=2     # max REQUESTED/MATCHING/ACCEPTED rides at once
FRAUD_DUPLICATE_WINDOW_MINUTES=10
FRAUD_MAX_DUPLICATES=3            # same-pickup requests in window before block

# ============ Driver settlement (RazorpayX) ============
SETTLEMENT_ENABLED=true
SETTLEMENT_CRON=0 3 * * *         # daily 03:00 (server TZ)
SETTLEMENT_COMMISSION_PERCENT=20

# ============ Analytics ============
ANALYTICS_ENABLED=true
ANALYTICS_DEFAULT_DAYS=30
ANALYTICS_RETENTION_DAYS=90

# ============ FCM push notifications (optional) ============
FCM_SERVICE_ACCOUNT_JSON=         # path to firebase service-account.json

# ============ Email (SendGrid, optional) ============
SENDGRID_API_KEY=                 # required for EMAIL channel
NOTIFICATIONS_FROM_EMAIL=         # verified sender, e.g. no-reply@obbian.com

# ============ Sentry (optional) ============
SENTRY_DSN=

# Roju agent bridge
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_HMAC_SECRET=
AGENT_HMAC_SECRET=

# ==========================================================================
# Production-readiness settings (migrations 005-010)
# ==========================================================================

# ============ Wallet ledger (migration 005) ============
# The ledger is the financial source of truth; drivers.walletBalancePaise is a
# cache. Reconciliation replays SUM(amountPaise) per driver and alerts on drift
# — drift means some write path bypassed the ledger, which is a P1.
LEDGER_RECONCILE_ENABLED=true
LEDGER_RECONCILE_CRON=0 4 * * *   # daily 04:00 (server TZ)
LEDGER_RECONCILE_BATCH_SIZE=500   # drivers per batch; keeps locks short
LEDGER_MAX_MANUAL_ADJUSTMENT_PAISE=5000000  # ₹50,000 ceiling for an ops correction

# ============ GST invoicing (migration 005) ============
# India mandates a taxable invoice per ride. Fares are quoted TAX-INCLUSIVE, so
# the invoice works backwards from the gross.
# PRODUCTION: boot FAILS if INVOICE_ENABLED=true and GSTIN/legal name are unset
# (an invoice without them is not a legally valid tax document).
INVOICE_ENABLED=true
INVOICE_GST_RATE_PERCENT=5        # 5% = passenger road transport without ITC
INVOICE_SAC_CODE=996422           # passenger transport by road
INVOICE_SERIES=OBN                # number format: {series}/{FY}/{000001}
INVOICE_SELLER_GSTIN=             # REQUIRED in production
INVOICE_SELLER_LEGAL_NAME=        # REQUIRED in production
INVOICE_SELLER_STATE_CODE=TS      # seller home state; differing supply = IGST

# ============ Driver compliance gate (migration 006) ============
# A driver may not go ONLINE unless DL + RC + insurance are VERIFIED and
# unexpired. PRODUCTION: boot FAILS if COMPLIANCE_ENFORCE_DISPATCH=false —
# dispatching unverified drivers is a regulatory violation, not a tunable.
COMPLIANCE_ENFORCE_DISPATCH=true
COMPLIANCE_EXPIRY_SWEEP_ENABLED=true
COMPLIANCE_EXPIRY_SWEEP_CRON=30 2 * * *
COMPLIANCE_EXPIRY_WARNING_DAYS=15 # warn the driver before dispatch eligibility lapses
COMPLIANCE_UPLOAD_URL_TTL_SECONDS=900
COMPLIANCE_MAX_DOCUMENT_BYTES=5242880  # 5 MiB

# ============ Cancellation penalties (migration 008) ============
# Replaces the old flat ₹50 fee, which taught abusers where the ceiling was.
# Tiers are paise, indexed by offence count in the rolling window; the last
# value applies to every further offence.
CANCELLATION_GRACE_MINUTES=2      # free cancellation window after request
CANCELLATION_RIDER_TIERS_PAISE=2000,5000,10000    # ₹20 → ₹50 → ₹100
CANCELLATION_DRIVER_TIERS_PAISE=5000,10000,20000  # ₹50 → ₹100 → ₹200
CANCELLATION_WINDOW_HOURS=24
CANCELLATION_AUTO_SUSPEND_THRESHOLD=0  # 0 = disabled

# ============ Live ETA refresh (migration 007) ============
# rides.durationMin keeps the original quote; etaMinutes is recomputed from the
# driver's real position so riders do not stare at a frozen estimate.
ETA_REFRESH_ENABLED=true
ETA_REFRESH_INTERVAL_SECONDS=30
ETA_STALE_AFTER_SECONDS=60        # skip the maps provider unless this stale
ETA_REFRESH_BATCH_SIZE=200        # bounds provider spend per sweep

# ============ GPS breadcrumbs / tracking (migration 007) ============
# Location pings NEVER hit Postgres synchronously (AGENTS.md §7). They land in
# Redis; a batched writer samples them into ride_route_points.
TRACKING_BREADCRUMB_SAMPLE_SECONDS=15     # max one persisted point per ride per N s
TRACKING_BREADCRUMB_FLUSH_INTERVAL_MS=5000
TRACKING_BREADCRUMB_FLUSH_BATCH_SIZE=500
TRACKING_LOCATION_RATE_LIMIT_PER_MINUTE=40  # per driver; blocks runaway clients
TRACKING_REST_RATE_LIMIT_PER_MINUTE=60       # per rider; REST tracking fallback
TRACKING_BREADCRUMB_RETENTION_DAYS=90     # enforced by DROP PARTITION
TRACKING_MAX_SPEED_KMPH=200               # implausible jump = rejected fix

# ============ Partition maintenance (migration 010) ============
# Pre-creates future partitions so an insert can never fail for want of one,
# and drops elapsed ones so retention is instant instead of a huge DELETE.
PARTITION_MAINTENANCE_ENABLED=true
PARTITION_MAINTENANCE_CRON=0 1 * * *
PARTITION_PRECREATE_DAYS=7        # must comfortably exceed the cron interval
PARTITION_PRECREATE_MONTHS=2
PARTITION_SURGE_RETENTION_DAYS=365

# ============ Realtime (Socket.IO) ============
# The Redis adapter is what makes horizontal scaling CORRECT: without it a
# rider on pod A never receives a driver location emitted on pod B. Leave ON.
REALTIME_REDIS_ADAPTER_ENABLED=true
REALTIME_CORS_ORIGINS=            # browser origins; mobile apps send no Origin
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000

# ============ Observability ============
# Metrics bind a SEPARATE port so the scrape endpoint is never reachable from
# the public ingress that serves the API.
METRICS_ENABLED=true
METRICS_PORT=9464
METRICS_PATH=/metrics
METRICS_PREFIX=obbian_
LOG_FORMAT=json                   # json | pretty (pretty for local dev)
SLOW_QUERY_MS=500                 # warn above this
SLOW_REQUEST_MS=1000

# ============ Redis resilience ============
# Redis is on the critical path for matching, geo, surge and fraud. Without a
# breaker one blip fails every active ride; with it those features degrade and
# the rest of the platform keeps serving.
REDIS_BREAKER_ENABLED=true
REDIS_BREAKER_FAILURE_THRESHOLD=5 # consecutive failures before the circuit opens
REDIS_BREAKER_OPEN_MS=10000       # open duration before a single trial request
REDIS_COMMAND_TIMEOUT_MS=1000     # per-command; stops a hung Redis holding threads

# ============ Referrals (migration 009) ============
REFERRAL_ENABLED=true
REFERRAL_REFEREE_REWARD_PAISE=5000    # ₹50
REFERRAL_REFERRER_REWARD_PAISE=10000  # ₹100
REFERRAL_QUALIFYING_RIDES=1           # completed rides before reward qualifies
REFERRAL_MAX_REDEMPTIONS_PER_CODE=0   # 0 = unlimited
REFERRAL_CODE_LENGTH=8

# ============ Driver incentives (migration 009) ============
INCENTIVE_ENABLED=true
INCENTIVE_PAYOUT_CRON=15 3 * * *
INCENTIVE_PAYOUT_BATCH_SIZE=200
INCENTIVE_MAX_BONUS_PAISE=500000  # ₹5,000 ceiling per incentive

# ============ Geofenced zones (migration 009) ============
# Replaces hard-coded city bounding boxes; point-in-polygon runs against a
# PostGIS GIST index on the quote path.
ZONES_ENABLED=true
ZONES_CACHE_TTL_SECONDS=300

# ============ Incidents / safety ops (migration 008) ============
INCIDENT_REFERENCE_PREFIX=INC     # e.g. INC-8F3K2Q, quoted to riders in support
INCIDENT_AUTO_ESCALATE_CRITICAL=true  # ACCIDENT/HARASSMENT forced to CRITICAL
INCIDENT_CRITICAL_WEBHOOK_URL=    # ops on-call ping; empty = log only
INCIDENT_MAX_COMPENSATION_PAISE=200000  # ₹2,000 without escalation

# ============ Retention sweeps ============
RETENTION_ENABLED=true
RETENTION_CRON=45 2 * * *
RETENTION_PROCESSED_WEBHOOK_DAYS=30  # only needs to outlive provider retries
RETENTION_PUBLISHED_OUTBOX_DAYS=30
RETENTION_READ_NOTIFICATION_DAYS=90

# ============ Analytics read replica (optional) ============
# Routes heavy aggregate queries off the primary. Falls back to the primary
# when unset (see DrizzleModule ANALYTICS_DB).
ANALYTICS_DATABASE_URL=
